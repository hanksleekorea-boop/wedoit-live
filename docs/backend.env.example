# 공개해도 되는 주소와 공개키만 넣습니다. 서버 관리자 키·service-role 키는 금지합니다.
WEDOIT_BACKEND_ENDPOINT=
WEDOIT_BACKEND_PUBLISHABLE_KEY=

# 아래 값은 원격 검사 전용 테스트 계정의 짧은 수명 토큰입니다. 저장소에 커밋하지 않습니다.
WEDOIT_REMOTE_OWNER_TOKEN=
WEDOIT_REMOTE_MEMBER_TOKEN=
WEDOIT_REMOTE_STRANGER_TOKEN=

# schema 6을 적용한 테스트 데이터의 읽기 전용 fixture ID입니다.
WEDOIT_REMOTE_PRIVATE_GOAL_ID=
WEDOIT_REMOTE_CIRCLE_GOAL_ID=
WEDOIT_REMOTE_PUBLIC_GOAL_ID=

